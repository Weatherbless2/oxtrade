[app]
name=oxApp
version=0.1.0
log_level=INFO

[server]
host=127.0.0.1
port=18080

[transport]
# mock: 本地开发默认值；hpsocket: 连接 C++ oxMBS 正式 PackMessage 服务。
kind=mock
hpsocket_host=127.0.0.1
hpsocket_port=18080
session_id=mock-session
connect_timeout_seconds=3
read_timeout_seconds=0.5
reconnect_enabled=true

[log]
directory=logs

[market]
# mock: 离线演示默认值；pytdx: 连接 QuantFabric 的本机 JSON-lines Bridge，超时后自动回退 Mock。
source=mock
pytdx_host=127.0.0.1
pytdx_port=19001
reconnect_seconds=2
fallback_after_seconds=5
ui_refresh_ms=200
tick_buffer_size=500
bar_buffer_size=480
mock_interval_ms=800
